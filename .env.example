# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP server port (default 3000)
PORT=3000

# DATA_DIR: Directory where SQLite database is stored
DATA_DIR=

# OWNER_PASSWORD: Optional initial/override owner password for Admin Console
OWNER_PASSWORD=

# PUBLIC_URL: Public canonical URL for sitemap.xml, robots.txt, and Chargily webhooks
PUBLIC_URL=

# CHARGILY_SECRET_KEY: Chargily Pay secret key (test or live)
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test


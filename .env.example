# DATABASE_URL: Required in production (Supabase PostgreSQL connection string - West EU Ireland)
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# NODE_ENV: Set to production on Ample
NODE_ENV=development

# PORT: HTTP server port (Ample injects PORT automatically; default 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PUBLIC_URL: Public canonical URL for sitemap.xml, robots.txt, and Chargily webhooks
PUBLIC_URL=

# OWNER_PASSWORD: Optional initial/override owner password for Admin Console
OWNER_PASSWORD=

# GEMINI_API_KEY: Required for Admin AI assistant calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CHARGILY_SECRET_KEY: Chargily Pay secret key (test or live)
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# DELIVERY_TOKEN / DELIVERY_API_ID: Optional carrier API credentials (Yalidine, ZR Express, Maystro)
DELIVERY_TOKEN=
DELIVERY_API_ID=

# DATA_DIR: Local SQLite path used only in dev fallback or as source for db:migrate
DATA_DIR=
